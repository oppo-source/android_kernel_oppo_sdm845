/* #ifdef OPLUS_FEATURE_FACERECOGNITION  */
&qupv3_se3_i2c {
        status = "ok";
        lm3644@63 {
                compatible = "lm3644";
                reg = <0x63>;
                lm3644,hwen-gpio = <&tlmm 39 0x00>;
                lm3644,ldo-en-gpio = <&tlmm 40 0x00>;
                lm3644,watchdog-gpio = <&tlmm 81 0x00>;
                lm3644,watchdog-en-gpio = <&tlmm 33 0x00>;
                status = "okay";
        };
        lm3643@67 {
                compatible = "lm3643";
                reg = <0x67>;
                lm3643,hwen-gpio = <&tlmm 113 0x00>;
                status = "okay";
        };
        aw36413@6b {
                compatible = "aw36413";
                reg = <0x6b>;
                aw36413,hwen-gpio = <&tlmm 113 0x00>;
                status = "okay";
        };
};
/* #endif OPLUS_FEATURE_FACERECOGNITION  */

